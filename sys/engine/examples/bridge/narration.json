{
  "durationRange": [
    158.5,
    173.5
  ],
  "phrases": [
    {
      "id": "b01p1",
      "sceneId": "s01",
      "text": "Nhìn cây cầu này rất chắc. Nhưng bạn có dám bước lên?",
      "role": "hook",
      "after": {
        "kind": "sentence",
        "seconds": 0.35
      }
    },
    {
      "id": "b01p2",
      "sceneId": "s01",
      "text": "Hãy khoan trả lời; chúng ta còn chưa nhìn thấy phần bên dưới.",
      "role": "hook",
      "after": {
        "kind": "sentence",
        "seconds": 0.35
      }
    },
    {
      "id": "b01p3",
      "sceneId": "s01",
      "text": "Vẻ ngoài ấy dễ khiến chúng ta bỏ qua bước kiểm tra.",
      "role": "hook",
      "after": {
        "kind": "scene",
        "seconds": 0.5
      }
    },
    {
      "id": "b02p1",
      "sceneId": "s02",
      "text": "Một câu trả lời của AI cũng có thể tạo cảm giác như thế:",
      "role": "body",
      "after": {
        "kind": "sentence",
        "seconds": 0.35
      }
    },
    {
      "id": "b02p2",
      "sceneId": "s02",
      "text": "gọn gàng, trôi chảy, khiến bạn muốn dùng ngay.",
      "role": "body",
      "after": {
        "kind": "sentence",
        "seconds": 0.35
      }
    },
    {
      "id": "b03p1",
      "sceneId": "s03",
      "text": "Nhưng một câu trả lời gồm nhiều chi tiết.",
      "role": "body",
      "after": {
        "kind": "sentence",
        "seconds": 0.35
      }
    },
    {
      "id": "b03p2",
      "sceneId": "s03",
      "text": "Chỉ một chi tiết không có căn cứ cũng đủ làm việc bạn sắp làm bị lệch.",
      "role": "body",
      "after": {
        "kind": "sentence",
        "seconds": 0.35
      }
    },
    {
      "id": "b03p3",
      "sceneId": "s03",
      "text": "Hãy theo từng chi tiết, thay vì đánh giá cả đoạn một lần.",
      "role": "body",
      "after": {
        "kind": "scene",
        "seconds": 0.5
      }
    },
    {
      "id": "b04p1",
      "sceneId": "s04",
      "text": "Câu văn nghe hợp lý không tự biến thành bằng chứng.",
      "role": "body",
      "after": {
        "kind": "sentence",
        "seconds": 0.35
      }
    },
    {
      "id": "b04p2",
      "sceneId": "s04",
      "text": "Dấu tích này chỉ cho thấy cảm giác tin tưởng của người đọc.",
      "role": "body",
      "after": {
        "kind": "sentence",
        "seconds": 0.35
      }
    },
    {
      "id": "b05p1",
      "sceneId": "s05",
      "text": "Ta dùng cây cầu làm phép ví von.",
      "role": "body",
      "after": {
        "kind": "sentence",
        "seconds": 0.35
      }
    },
    {
      "id": "b05p2",
      "sceneId": "s05",
      "text": "Mặt cầu là điều được nói ra;",
      "role": "body",
      "after": {
        "kind": "sentence",
        "seconds": 0.35
      }
    },
    {
      "id": "b05p3",
      "sceneId": "s05",
      "text": "các trụ bên dưới là căn cứ cho điều đó.",
      "role": "body",
      "after": {
        "kind": "sentence",
        "seconds": 0.35
      }
    },
    {
      "id": "b05p4",
      "sceneId": "s05",
      "text": "Mỗi trụ cần gắn với đúng phần thông tin nó hỗ trợ.",
      "role": "body",
      "after": {
        "kind": "scene",
        "seconds": 0.5
      }
    },
    {
      "id": "b06p1",
      "sceneId": "s06",
      "text": "Câu trả lời có thể chứa cả thông tin đúng lẫn phần được thêm vào mà chưa được kiểm tra.",
      "role": "body",
      "after": {
        "kind": "sentence",
        "seconds": 0.35
      }
    },
    {
      "id": "b06p2",
      "sceneId": "s06",
      "text": "Không nên đánh đồng tất cả. Phần có căn cứ vẫn giữ, phần chưa rõ cần đánh dấu.",
      "role": "body",
      "after": {
        "kind": "scene",
        "seconds": 0.5
      }
    },
    {
      "id": "b07p1",
      "sceneId": "s07",
      "text": "Thử một tình huống minh họa. Thông báo ghi cuộc họp lúc chín giờ, dành cho nhóm thiết kế.",
      "role": "body",
      "after": {
        "kind": "sentence",
        "seconds": 0.35
      }
    },
    {
      "id": "b07p2",
      "sceneId": "s07",
      "text": "Tài liệu chưa nói địa điểm. Chúng ta giữ nguyên thông báo để có chỗ đối chiếu.",
      "role": "body",
      "after": {
        "kind": "scene",
        "seconds": 0.5
      }
    },
    {
      "id": "b08p1",
      "sceneId": "s08",
      "text": "Bản tóm tắt giữ đúng giờ họp và đúng nhóm tham gia.",
      "role": "body",
      "after": {
        "kind": "sentence",
        "seconds": 0.35
      }
    },
    {
      "id": "b08p2",
      "sceneId": "s08",
      "text": "Ta tìm được cả hai chi tiết trong thông báo ban đầu.",
      "role": "body",
      "after": {
        "kind": "sentence",
        "seconds": 0.35
      }
    },
    {
      "id": "b08p3",
      "sceneId": "s08",
      "text": "Hai đường nối này cho thấy đúng nơi thông tin xuất phát.",
      "role": "body",
      "after": {
        "kind": "scene",
        "seconds": 0.5
      }
    },
    {
      "id": "b09p1",
      "sceneId": "s09",
      "text": "Nhưng bản tóm tắt còn thêm phòng ba trăm linh hai.",
      "role": "body",
      "after": {
        "kind": "sentence",
        "seconds": 0.35
      }
    },
    {
      "id": "b09p2",
      "sceneId": "s09",
      "text": "Chi tiết nghe rất cụ thể, nhưng cụ thể không có nghĩa là đúng.",
      "role": "body",
      "after": {
        "kind": "sentence",
        "seconds": 0.35
      }
    },
    {
      "id": "b09p3",
      "sceneId": "s09",
      "text": "Ta khoan mang chi tiết mới này vào kế hoạch thực tế.",
      "role": "body",
      "after": {
        "kind": "scene",
        "seconds": 0.5
      }
    },
    {
      "id": "b10p1",
      "sceneId": "s10",
      "text": "Tìm lại trong thông báo: không có số phòng này.",
      "role": "body",
      "after": {
        "kind": "sentence",
        "seconds": 0.35
      }
    },
    {
      "id": "b10p2",
      "sceneId": "s10",
      "text": "Đây là phần chưa có căn cứ trong tài liệu, dù cả câu vẫn đọc rất tự nhiên.",
      "role": "body",
      "after": {
        "kind": "sentence",
        "seconds": 0.35
      }
    },
    {
      "id": "b10p3",
      "sceneId": "s10",
      "text": "Đọc lại đoạn gốc quan trọng hơn vẻ chắc chắn của câu văn.",
      "role": "body",
      "after": {
        "kind": "scene",
        "seconds": 0.5
      }
    },
    {
      "id": "b11p1",
      "sceneId": "s11",
      "text": "Nhịp cầu này đang thiếu trụ đỡ.",
      "role": "body",
      "after": {
        "kind": "sentence",
        "seconds": 0.35
      }
    },
    {
      "id": "b11p2",
      "sceneId": "s11",
      "text": "Lỗi ta vừa thấy là tự thêm một dữ kiện không được nguồn đang dùng hỗ trợ.",
      "role": "body",
      "after": {
        "kind": "sentence",
        "seconds": 0.35
      }
    },
    {
      "id": "b11p3",
      "sceneId": "s11",
      "text": "Chỗ trống nhắc ta kiểm tra, chưa đủ để tự kết luận.",
      "role": "body",
      "after": {
        "kind": "scene",
        "seconds": 0.5
      }
    },
    {
      "id": "b12p1",
      "sceneId": "s12",
      "text": "Không cần đoán AI có tự tin đến đâu.",
      "role": "body",
      "after": {
        "kind": "sentence",
        "seconds": 0.35
      }
    },
    {
      "id": "b12p2",
      "sceneId": "s12",
      "text": "Việc hữu ích hơn là kiểm tra chi tiết nào bạn sắp dựa vào để hành động.",
      "role": "body",
      "after": {
        "kind": "sentence",
        "seconds": 0.35
      }
    },
    {
      "id": "b12p3",
      "sceneId": "s12",
      "text": "Bắt đầu từ thời gian, địa điểm hoặc người sẽ nhận việc.",
      "role": "body",
      "after": {
        "kind": "scene",
        "seconds": 0.5
      }
    },
    {
      "id": "b13p1",
      "sceneId": "s13",
      "text": "Đối chiếu từng ý quan trọng với nguồn gốc.",
      "role": "body",
      "after": {
        "kind": "sentence",
        "seconds": 0.35
      }
    },
    {
      "id": "b13p2",
      "sceneId": "s13",
      "text": "Nếu có dẫn nguồn, hãy mở và đọc đúng đoạn liên quan, không chỉ nhìn thấy một đường dẫn.",
      "role": "body",
      "after": {
        "kind": "sentence",
        "seconds": 0.35
      }
    },
    {
      "id": "b13p3",
      "sceneId": "s13",
      "text": "Nguồn phải thực sự nói điều mà câu trả lời đang khẳng định.",
      "role": "body",
      "after": {
        "kind": "scene",
        "seconds": 0.5
      }
    },
    {
      "id": "b14p1",
      "sceneId": "s14",
      "text": "Với địa điểm chưa có thông tin, bỏ số phòng được thêm vào.",
      "role": "body",
      "after": {
        "kind": "sentence",
        "seconds": 0.35
      }
    },
    {
      "id": "b14p2",
      "sceneId": "s14",
      "text": "Ghi rõ chưa xác định, rồi hỏi người tổ chức để có câu trả lời.",
      "role": "body",
      "after": {
        "kind": "sentence",
        "seconds": 0.35
      }
    },
    {
      "id": "b14p3",
      "sceneId": "s14",
      "text": "Giữ dấu hỏi giúp người đọc nhận biết phần cần bổ sung.",
      "role": "body",
      "after": {
        "kind": "scene",
        "seconds": 0.5
      }
    },
    {
      "id": "b15p1",
      "sceneId": "s15",
      "text": "Yêu cầu AI chỉ dùng tài liệu được cung cấp và chỉ ra phần còn thiếu có thể giúp ích.",
      "role": "body",
      "after": {
        "kind": "sentence",
        "seconds": 0.35
      }
    },
    {
      "id": "b15p2",
      "sceneId": "s15",
      "text": "Tuy vậy, bạn vẫn cần kiểm tra kết quả.",
      "role": "body",
      "after": {
        "kind": "sentence",
        "seconds": 0.35
      }
    },
    {
      "id": "b15p3",
      "sceneId": "s15",
      "text": "Một câu lệnh tốt vẫn cần đi cùng thao tác kiểm tra.",
      "role": "body",
      "after": {
        "kind": "scene",
        "seconds": 0.5
      }
    },
    {
      "id": "b16p1",
      "sceneId": "s16",
      "text": "Chưa có bằng chứng thì chưa dùng chi tiết đó làm căn cứ.",
      "role": "body",
      "after": {
        "kind": "sentence",
        "seconds": 0.35
      }
    },
    {
      "id": "b16p2",
      "sceneId": "s16",
      "text": "Ta để khoảng trống rõ ràng, thay vì trang trí cho nó giống một phần đã chắc chắn.",
      "role": "body",
      "after": {
        "kind": "sentence",
        "seconds": 0.35
      }
    },
    {
      "id": "b16p3",
      "sceneId": "s16",
      "text": "Cây cầu chỉ là ví von để nhớ mối quan hệ này.",
      "role": "body",
      "after": {
        "kind": "scene",
        "seconds": 0.5
      }
    },
    {
      "id": "b17p1",
      "sceneId": "s17",
      "text": "Đến lượt bạn: nguồn chỉ ghi bắt đầu lúc chín giờ.",
      "role": "body",
      "after": {
        "kind": "sentence",
        "seconds": 0.35
      }
    },
    {
      "id": "b17p2",
      "sceneId": "s17",
      "text": "Bản tóm tắt nói cuộc họp kéo dài ba mươi phút.",
      "role": "body",
      "after": {
        "kind": "sentence",
        "seconds": 0.35
      }
    },
    {
      "id": "b17p3",
      "sceneId": "s17",
      "text": "Chi tiết nào cần kiểm tra thêm?",
      "role": "body",
      "after": {
        "kind": "sentence",
        "seconds": 0.35
      }
    },
    {
      "id": "b18p1",
      "sceneId": "s18",
      "text": "Giờ bắt đầu có trong nguồn. Thời lượng chưa có.",
      "role": "body",
      "after": {
        "kind": "sentence",
        "seconds": 0.35
      }
    },
    {
      "id": "b18p2",
      "sceneId": "s18",
      "text": "Chưa thể kết luận cuộc họp dài bao lâu chỉ từ giờ bắt đầu của nó.",
      "role": "body",
      "after": {
        "kind": "sentence",
        "seconds": 0.35
      }
    },
    {
      "id": "b18p3",
      "sceneId": "s18",
      "text": "Giờ bắt đầu không tự cho biết lúc cuộc họp kết thúc.",
      "role": "body",
      "after": {
        "kind": "scene",
        "seconds": 0.5
      }
    },
    {
      "id": "b19p1",
      "sceneId": "s19",
      "text": "Trước khi gửi, chọn một chi tiết quan trọng.",
      "role": "body",
      "after": {
        "kind": "sentence",
        "seconds": 0.35
      }
    },
    {
      "id": "b19p2",
      "sceneId": "s19",
      "text": "Tìm đúng căn cứ của nó. Thói quen kiểm tra nhỏ giúp tránh dùng một chi tiết chưa chắc.",
      "role": "body",
      "after": {
        "kind": "scene",
        "seconds": 0.5
      }
    },
    {
      "id": "b20p1",
      "sceneId": "s20",
      "text": "Hợp lý chưa chắc có căn cứ.",
      "role": "close",
      "after": {
        "kind": "sentence",
        "seconds": 0.35
      }
    },
    {
      "id": "b20p2",
      "sceneId": "s20",
      "text": "Đừng chỉ nhìn mặt cầu. Hãy nhìn những gì đang đỡ nó.",
      "role": "close",
      "after": {
        "kind": "sentence",
        "seconds": 0.35
      }
    },
    {
      "id": "b20p3",
      "sceneId": "s20",
      "text": "Những căn cứ rõ ràng mới giúp chúng ta quyết định bước tiếp.",
      "role": "close",
      "after": {
        "kind": "scene",
        "seconds": 0.5
      }
    }
  ]
}
